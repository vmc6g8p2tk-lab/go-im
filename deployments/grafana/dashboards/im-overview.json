{
  "uid": "go-im-overview",
  "title": "Go IM Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {"id": 1, "title": "WebSocket connections", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "im_websocket_connections", "refId": "A"}]},
    {"id": 2, "title": "Created messages per second", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "sum by (kind) (rate(im_messages_total{result=\"created\"}[1m]))", "refId": "A"}]},
    {"id": 3, "title": "ACK latency P95", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(im_ack_latency_seconds_bucket[5m])))", "refId": "A"}]},
    {"id": 4, "title": "Local enqueue and drops", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "sum by (result) (rate(im_delivery_enqueue_total[1m]))", "refId": "A"}]},
    {"id": 5, "title": "Send queue frames", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "targets": [{"expr": "im_websocket_send_queue_frames", "refId": "A"}]},
    {"id": 6, "title": "Slow consumer disconnects", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "targets": [{"expr": "rate(im_slow_consumers_total[5m])", "refId": "A"}]},
    {"id": 7, "title": "Database query P95", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(im_db_operation_seconds_bucket[5m])))", "refId": "A"}]},
    {"id": 8, "title": "Redis errors", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}, "targets": [{"expr": "sum(rate(im_redis_operation_seconds_count{result=\"error\"}[5m]))", "refId": "A"}]},
    {"id": 9, "title": "Kafka producer and consumer", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32}, "targets": [{"expr": "im_kafka_producer_up", "refId": "A"}, {"expr": "im_kafka_consumer_up", "refId": "B"}]},
    {"id": 10, "title": "Go heap bytes", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32}, "targets": [{"expr": "go_memstats_heap_alloc_bytes", "refId": "A"}]}
  ]
}
